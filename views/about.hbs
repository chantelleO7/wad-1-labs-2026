{{> menu id="about"}}

<section class="ui center aligned middle aligned segment">
  {{#each employees}}
  <h2 class="ui header">
    About the Playlist App
  </h2>
  <p>
    More information about the app
  </p>

  <div class="ui centered card">
    <div class="image">
      <img src="{{image}}">
    </div>
    <div class="content">
      <a class="header">{{fullname}}</a>
      <div class="meta">
        <span class="date">Joined in {{joined}}</span>
      </div>
      <div class="description">
        {{name}} is a {{job}} living in {{city}}.
      </div>
    </div>
    <div class="extra content">
      <a>
        <i class="user icon"></i>
        {{employee.mates}} contacts
      </a>
    </div>
  </div>
  {{/each}}
</section>
{{> menu id="about"}}

<section class="ui center aligned middle aligned segment">
  <h2 class="ui header">
    About the Playlist App
  </h2>
  <p>
    More information about the app
  </p>

  <div class="ui centered card">
    <div class="image">
      <img src="{{employee.image}}">
    </div>
    <div class="content">
      <a class="header">{{employee.fullname}}</a>
      <div class="meta">
        <span class="date">Joined in {{employee.joined}}</span>
      </div>
      <div class="description">
        {{employee.name}} is a {{employee.job}} living in {{employee.city}}.
      </div>
    </div>
    <div class="extra content">
      <a>
        <i class="user icon"></i>
        {{employee.mates}} contacts
      </a>
    </div>
  </div>
</section>